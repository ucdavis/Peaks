
@{
    ViewData["Title"] = "Upload CSV";
}
<div class="card">
    <div class="card-header-primary">
        <div class="card-head">
            <h2><hero-icon name="arrow-up-tray" class="size-4"></hero-icon> Upload CSV Reports</h2>
        </div>
    </div>
    <div class="card-content">
        <div class="row justify-content-betwee">
            <div class="report-list col-md-3 equipment-color">
                <h3><hero-icon name="computer-desktop" class="size-4"></hero-icon> Equipment Uploads</h3>
                <ul>
                    <li>
                        <a asp-controller="TeamAdmin" asp-action="UploadEquipment">Upload Equipment from CSV <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                </ul>
            </div>
            <div class="report-list col-md-3 keys-color">
                <h3><hero-icon name="key" class="size-4"></hero-icon> Keys Uploads</h3>
                <ul>
                    <li>
                        <a asp-action="UploadKeys">Upload Keys from CSV <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                </ul>
            </div>
            <div class="report-list col-md-3 people-color">
                <h3><hero-icon name="users" class="size-4"></hero-icon> People Uploads</h3>
                <ul>
                    <li>
                        <a asp-controller="PersonAdmin" asp-action="UploadPeople">Upload People from CSV <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


