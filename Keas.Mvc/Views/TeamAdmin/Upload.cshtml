@{ ViewData["Title"] = "CSV imports"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">CSV imports</h1>
            <p class="m-0 text-base-content/70">Import equipment, keys, or people into your team.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-action="Index" ><hero-icon name="arrow-left" class="size-4"></hero-icon>Team settings</a></div>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
        <a class="group flex flex-col gap-4 rounded-sm border border-main-border bg-base-100 p-5 text-base-content transition hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-primary" asp-controller="TeamAdmin" asp-action="UploadEquipment">
            <div class="flex items-center justify-between"><hero-icon name="computer-desktop" class="size-6"></hero-icon><hero-icon name="arrow-right" class="size-5 text-base-content/50"></hero-icon></div>
            <div><h2 class="m-0 text-xl font-bold">Equipment</h2><p class="mb-0 mt-2 text-sm text-base-content/70">Upload equipment records and assignments from a CSV file.</p></div>
        </a>
        <a class="group flex flex-col gap-4 rounded-sm border border-main-border bg-base-100 p-5 text-base-content transition hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-primary" asp-controller="TeamAdmin" asp-action="UploadKeys">
            <div class="flex items-center justify-between"><hero-icon name="key" class="size-6"></hero-icon><hero-icon name="arrow-right" class="size-5 text-base-content/50"></hero-icon></div>
            <div><h2 class="m-0 text-xl font-bold">Keys</h2><p class="mb-0 mt-2 text-sm text-base-content/70">Upload key patterns, serial numbers, and assignments.</p></div>
        </a>
        <a class="group flex flex-col gap-4 rounded-sm border border-main-border bg-base-100 p-5 text-base-content transition hover:bg-base-200 focus-visible:outline-2 focus-visible:outline-primary" asp-controller="PersonAdmin" asp-action="UploadPeople">
            <div class="flex items-center justify-between"><hero-icon name="users" class="size-6"></hero-icon><hero-icon name="arrow-right" class="size-5 text-base-content/50"></hero-icon></div>
            <div><h2 class="m-0 text-xl font-bold">People</h2><p class="mb-0 mt-2 text-sm text-base-content/70">Upload people and their details from a CSV file.</p></div>
        </a>
    </div>
</div>
