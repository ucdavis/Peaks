@model System.Collections.Generic.List<Keas.Core.Models.SpaceSearchModel>
@{ ViewData["Title"] = "Organization search"; }
<div class="space-y-8 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Organization search</h1>
            <p class="m-0 text-base-content/70">Find a financial organization by building and add it to your team.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="TeamAdmin" asp-action="Index"><hero-icon name="arrow-left" class="size-4"></hero-icon>Team settings</a></div>
    </div>
    @{ await Html.RenderPartialAsync("_SpaceSearchForm"); }
    <section class="space-y-4" aria-labelledby="search-results-heading">
        <h2 id="search-results-heading" class="m-0 text-xl font-semibold">Search results</h2>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4"><table id="table" class="table dataTable">
                    <thead>
                        <tr>
                            <th scope="col">Building Name</th>
                            <th scope="col">Department</th>
                            <th scope="col">Org</th>
                            <th scope="col">Add to Team</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BldgName</td>
                                <td>@item.DeptName</td>
                                <td>@item.ChartNum-@item.OrgId</td>
                                <td>
                                    <form asp-action="AddFISOrg" method="post">
                                        @Html.Hidden("Chart", item.ChartNum)
                                        @Html.Hidden("OrgCode", item.OrgId)
                                        <input type="submit" value="Add" class="btn btn-sm btn-outline" />
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
    </section>
</div>
@section Scripts {

     @{await Html.RenderPartialAsync("_ImportJS");}
     <script type="text/javascript">
        $(function () {
            $("#table").DataTable({
                "columnDefs": [
                    {
                        targets: -1,
                        orderable: false,
                    },

                ]
            });
        });
    </script>
}

@section Styles
{
    @await Html.PartialAsync("_ReportStylePartial")
}
