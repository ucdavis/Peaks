@model Keas.Core.Domain.TeamPpsDepartment
@{ ViewData["Title"] = "Remove PPS department"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">Remove PPS department</h1>
            <p class="m-0 text-base-content/70">Review the association before removing it from this team.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-action="Index" ><hero-icon name="arrow-left" class="size-4"></hero-icon>Team settings</a></div>
    </div>
    <div class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <dl class="m-0 grid gap-4 sm:grid-cols-2"><div><dt class="text-sm text-base-content/60">@Html.DisplayNameFor(model => model.DepartmentName)</dt><dd class="m-0 mt-1 font-medium">@Html.DisplayFor(model => model.DepartmentName)</dd></div>
<div><dt class="text-sm text-base-content/60">@Html.DisplayNameFor(model => model.PpsDepartmentCode)</dt><dd class="m-0 mt-1 font-medium">@Html.DisplayFor(model => model.PpsDepartmentCode)</dd></div>
<div><dt class="text-sm text-base-content/60">@Html.DisplayNameFor(model => model.Team.Name)</dt><dd class="m-0 mt-1 font-medium">@Html.DisplayFor(model => model.Team.Name)</dd></div></dl>
        <form asp-action="RemovePpsDepartment" class="flex flex-wrap gap-2 border-t border-main-border pt-5">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-error">Remove PPS department</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
