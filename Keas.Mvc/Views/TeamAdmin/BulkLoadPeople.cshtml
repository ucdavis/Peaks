@model IEnumerable<Keas.Core.Domain.TeamPpsDepartment>
@{ ViewData["Title"] = "Bulk load people"; }
<div class="space-y-8 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Bulk load people</h1>
            <p class="m-0 text-base-content/70">Import people from IAM using your team’s PPS departments.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="TeamAdmin" asp-action="Index"><hero-icon name="arrow-left" class="size-4"></hero-icon>Team settings</a></div>
    </div>
    <div role="alert" class="alert alert-error max-w-4xl"><hero-icon name="exclamation-triangle" class="size-5"></hero-icon><span>Large departments can take a while to load. If the request times out, it continues in the background. Wait at least a couple of hours before running it again.</span></div>
    <div class="max-w-4xl space-y-8">
        <section class="space-y-4 text-sm leading-6" aria-labelledby="import-info-heading">
            <h2 id="import-info-heading" class="m-0 text-xl font-semibold">How the import works</h2>
            <p class="m-0">The loader adds new people as needed. You can run it again to import new employees; it does not remove people whose appointments have ended.</p>
            <p class="m-0"><a class="link text-primary" href="https://iam.ucdavis.edu/" target="_blank" rel="noopener noreferrer">Identity and Access Management (IAM)</a> supplies user information based on PPS department associations. Campus directory associations can differ from home department codes in PPS.</p>
            <a class="btn btn-outline" asp-controller="PersonAdmin" asp-action="UploadPeople"><hero-icon name="arrow-up-tray" class="size-4"></hero-icon>Import people from CSV</a>
        </section>
        <section class="space-y-4" aria-labelledby="departments-heading">
            <h2 id="departments-heading" class="m-0 text-xl font-semibold">PPS departments</h2>
            <ul class="m-0 list-none divide-y divide-main-border rounded-sm border border-main-border bg-base-100 p-0">
                @foreach (var dept in Model)
                {
                    <li class="flex flex-wrap items-center justify-between gap-2 p-4"><span class="font-medium">@dept.DepartmentName</span><span class="badge badge-ghost">@dept.PpsDepartmentCode</span></li>
                }
                @if (!Model.Any()) { <li class="p-4 text-sm text-base-content/60">No PPS departments are linked to this team.</li> }
            </ul>
            <form asp-action="LoadPeople" class="space-y-3">
                <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
                <button id="submitbtn" type="submit" class="btn btn-primary" disabled="@(!Model.Any())"><hero-icon name="users" class="size-4"></hero-icon>Load people from PPS</button>
            </form>
        </section>
    </div>
</div>
<div id="loading" role="status" aria-live="polite"><div id="loadingcontent"><p id="loadingspinner">Loading people… <hero-icon name="arrow-path" class="size-5 animate-spin"></hero-icon></p></div></div>
@section Scripts {

<script type="text/javascript">
    $(function () {
        $("#submitbtn").click(function () {
            $("#loading").fadeIn();
        });
    });
</script>

}

@section Styles {
<style type="text/css">
    #loading
    {
        display:none;
        position:fixed;
        left:0;
        top:0;
        width:100%;
        height:100%;
        background:rgba(255,255,255,0.8);
        z-index:1000;
    }

    #loadingcontent
    {
        display:table;
        position:fixed;
        left:0;
        top:0;
        width:100%;
        height:100%;
    }

    #loadingspinner
    {
        display: table-cell;
        vertical-align:middle;
        width: 100%;
        text-align: center;
        font-size:larger;
        padding-top:80px;
    }
</style>
}
