@using Keas.Core.Extensions
@using Keas.Core.Resources
@model List<KeyImportResults>

@{
    ViewData["Title"] = "Upload CSV Keys File";
}

<div class="space-y-8 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">Import keys</h1>
            <p class="m-0 text-base-content/70">Upload a CSV file using the format shown below.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="TeamAdmin" asp-action="Upload"><hero-icon name="arrow-left" class="size-4"></hero-icon>CSV imports</a></div>
    </div>
    <form asp-action="UploadKeys" method="post" enctype="multipart/form-data" class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
        <div class="space-y-2">
            <label for="file" class="block text-sm font-semibold">CSV file</label>
            <input type="hidden" id="filename" name="filename" value="" />
            <input type="file" id="file" name="file" class="file-input w-full" accept=".csv" required />
        </div>
        <div class="flex flex-wrap gap-2 border-t border-main-border pt-5"><button type="submit" class="btn btn-primary"><hero-icon name="arrow-up-tray" class="size-4"></hero-icon>Upload CSV</button><a class="btn btn-ghost" asp-controller="TeamAdmin" asp-action="Upload">Cancel</a></div>
    </form>
        @if (Model == null || Model.Count <= 0)
        {
            <div class="min-w-0 space-y-4">
                <div class="space-y-2">
                    <div class="space-y-2">
                        <h2 class="m-0 text-xl font-bold">Instructions and example</h2>
                    </div>
                </div>
                <div class="space-y-4 overflow-x-auto rounded-sm border border-main-border bg-base-100 p-5 [overflow-wrap:anywhere]">
                    <p>Format of the uploaded CSV file must be followed. Must have the following columns, and only these columns:</p><br>
                    <p><b>KeyName<span class="space">,</span>KeyCode<span class="space">,</span>KeyNotes<span class="space">,</span>KeyTags<span class="space">,</span>SerialNumber<span class="space">,</span>KerbUser<span class="space">,</span>DateIssued<span class="space">,</span>DateDue<span class="space">,</span>Status<span class="space">,</span>SerialNotes</b></p>
                    <p>Text above copies properly. If you type the list out, omit the space after the commas.</p>
                    <p>Or you can use the example <a href="@Url.Content("~/files/csv_key_exampleV2.csv")" class="btn btn-outline" role="button"><hero-icon name="arrow-down-tray" class="size-5"></hero-icon> CSV file.</a></p>
                    <p><hero-icon name="star" class="size-5" style="color: red"></hero-icon> Indicates new fields, Sept 2019</p>
                    <dl class="space-y-3 [&_dt]:font-semibold [&_dd]:ms-0 [&_dd]:text-sm [&_dd]:leading-6">
                        <dt>KeyName</dt>
                        <dd>Required - Description of key (e.g. Example Hall exterior doors). If the same KeyCode appears later in the document, only the first KeyName will be used.</dd>
                        <dt>KeyCode</dt>
                        <dd>Required - Number for this key. First part of number on key</dd>
                        <dt>KeyNotes <hero-icon name="star" class="size-5" style="color: red"></hero-icon></dt>
                        <dd>Optional - Notes about the Key Pattern. IMPORTANT! this will only be set if the key doesn't exist yet.</dd>
                        <dt>KeyTags <hero-icon name="star" class="size-5" style="color: red"></hero-icon></dt>
                        <dd>Optional - Tags for the Key Pattern. IMPORTANT! this will only be set if the key doesn't exist yet.</dd>
                        <dt>SerialNumber</dt>
                        <dd>Required - Identifier for this key within given KeyCode. Usually the second part of number on key. If serial is blank, the key will be created without any serials.</dd>
                        <dt>KerbUser</dt>
                        <dd>Kerberos ID of the person this serial is assigned to. May be left blank. If no ID provided, no assignment will be created</dd>
                        <dt>DateIssue</dt>
                        <dd>Date this serial was issued to the person</dd>
                        <dt>DateDue</dt>
                        <dd>Date this key should be returned</dd>
                        <dt>Status</dt>
                        <dd>Status of this serial. Valid entries are: @(string.Join(", ", KeySerialStatusModel.StatusList)) <hero-icon name="star" class="size-5" style="color: red"></hero-icon>. If blank, serial will be set to "Active"</dd>
                        <dt>SerialNotes <hero-icon name="star" class="size-5" style="color: red"></hero-icon></dt>
                        <dd>Optional - Notes about the physical key.</dd>
                    </dl>
                </div>
            </div>
        }

    @if (Model != null && Model.Count > 0)
    {
        <div class="space-y-4">
            <div class="min-w-0 space-y-4">
                <div class="space-y-2">
                    <div class="space-y-2">
                        <h2 class="m-0 text-xl font-bold">Import results</h2>
                    </div>
                </div>
                <div class="space-y-4 overflow-x-auto rounded-sm border border-main-border bg-base-100 p-5 [overflow-wrap:anywhere]">
                    <table id="results" class="table dataTable">
                        <thead>
                            <tr>
                                <th rowspan="2">Row</th>
                                <th rowspan="2">Success</th>

                                <th colspan="10">CSV Imported Values</th>
                                <th rowspan="2">Messages</th>
                                <th rowspan="2">Errors</th>
                            </tr>
                            <tr>
                                <th>KeyName</th>
                                <th>KeyCode</th>
                                <th>KeyNotes</th>
                                <th>KeyTags</th>
                                <th>SerialNumber</th>
                                <th>KerbUser</th>
                                <th>DateIssued</th>
                                <th>DateDue</th>
                                <th>Status</th>
                                <th>SerialNotes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var style = string.Empty;
                                if (!item.Success)
                                { style = "background-color: color-mix(in oklab, var(--color-error) 10%, transparent)"; }
                                <tr style="@style">
                                    <td>@item.LineNumber</td>
                                    <td>
                                        @item.Success.ToYesNoString()
                                    </td>
                                    <td style="word-wrap: break-word; word-break: break-all; white-space: normal;">
                                        @Html.DisplayFor(a => item.Import.KeyName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(a => item.Import.KeyCode)
                                    </td>
                                    <td style="word-wrap: break-word; word-break: break-all; white-space: normal;">
                                        @Html.DisplayFor(a => item.Import.KeyNotes)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(a => item.Import.KeyTags)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(a => item.Import.SerialNumber)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(a => item.Import.KerbUser)
                                    </td>
                                    <td>
                                        @item.Import.DateIssued.Format("d")
                                    </td>
                                    <td>
                                        @item.Import.DateDue.Format("d")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(a => item.Import.Status)
                                    </td>
                                    <td style="word-wrap: break-word; word-break: break-all; white-space: normal;">
                                        @Html.DisplayFor(a => item.Import.SerialNotes)
                                    </td>
                                    <td>
                                        @string.Join(", ", item.Messages)
                                    </td>
                                    <td>
                                        @string.Join(", ", item.ErrorMessage)
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }



</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
     @{await Html.RenderPartialAsync("_ImportJS");}
    <script type="text/javascript">
        $(function () {
            $("#results").dataTable({
                "dom": 'lBfrtip',
                "buttons": [
                    { extend: 'copyHtml5' },
                    { extend: 'excelHtml5' },
                    { extend: 'csvHtml5' },
                    { extend: 'print'},
                ],
                "columnDefs": [
                    { "width": "10%;", "targets": [2] },
                    { "type": "date", "targets": [8, 9] },
                ]
            });
        });
    </script>
}

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
