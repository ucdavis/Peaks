<section class="space-y-4 pb-8" aria-labelledby="space-search-heading">
    <div class="space-y-2"><h2 id="space-search-heading" class="m-0 text-xl font-semibold">Find an organization by building</h2><p class="m-0 text-sm text-base-content/70">Search campus spaces to find the organization to add.</p></div>
    <form asp-action="SearchBuilding" class="max-w-xl space-y-3">
        <label class="block text-sm font-semibold" for="building-search">Building name</label>
        <div class="flex flex-col gap-3 sm:flex-row">
            <input class="input min-w-0 w-full" id="building-search" name="id" placeholder="All or part of a building name" />
            <button type="submit" class="btn btn-primary"><hero-icon name="magnifying-glass" class="size-4"></hero-icon>Search</button>
        </div>
    </form>
</section>
