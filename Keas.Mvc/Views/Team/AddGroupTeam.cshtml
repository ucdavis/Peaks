@model Keas.Core.Models.GroupTeamPostModel
@{ ViewData["Title"] = "Add group team"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">Add group team</h1>
            <p class="m-0 text-base-content/70">Include a team in @Model.GroupName reporting.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-action="GroupDetails" asp-controller="Team" asp-route-id="@Model.GroupId"><hero-icon name="arrow-left" class="size-4"></hero-icon>Group details</a></div>
    </div>
    <form asp-action="AddGroupTeam" class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
        @Html.HiddenFor(a => a.GroupId)
        <div class="space-y-2">
            <label asp-for="TeamSlug" class="block text-sm font-semibold"></label>
            <input asp-for="TeamSlug" class="input w-full" />
            <span asp-validation-for="TeamSlug" class="block text-sm text-error"></span>

        </div>

        <div class="flex flex-wrap gap-2 border-t border-main-border pt-5">
            <button type="submit" class="btn btn-primary">Add team</button>
            <a class="btn btn-ghost" asp-action="GroupDetails" asp-controller="Team" asp-route-id="@Model.GroupId">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
