@model Keas.Core.Domain.Group
@{ ViewData["Title"] = $"Group: {Model.Name}"; }
<div class="space-y-10 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">@Model.Name</h1>
            <p class="m-0 text-base-content/70">Manage the users and teams included in this reporting group.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-action="Index" asp-controller="Admin" ><hero-icon name="arrow-left" class="size-4"></hero-icon>Administration</a></div>
    </div>
    <section class="space-y-4" aria-labelledby="users-heading">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 id="users-heading" class="m-0 text-xl font-bold">Group users</h2>
            <a class="btn btn-primary" asp-action="AddGroupUser" asp-route-id="@Model.Id"><hero-icon name="plus" class="size-4"></hero-icon>Add user</a>
        </div>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table dataTable" id="users-table">
                <thead><tr><th scope="col">Name</th><th scope="col">User ID</th><th scope="col">Email</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.GroupPermissions)
                {
                    <tr>
                        <td class="font-semibold">@item.User.Name</td><td>@item.User.Id</td><td><a class="link link-hover" href="mailto:@item.User.Email">@item.User.Email</a></td>
                        <td class="text-right"><form asp-action="RemoveGroupUser" asp-route-id="@item.Id" asp-route-groupId="@item.GroupId"><button type="submit" class="btn btn-sm btn-ghost text-error" aria-label="Remove @item.User.Name from group">Remove</button></form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <section class="space-y-4" aria-labelledby="teams-heading">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 id="teams-heading" class="m-0 text-xl font-bold">Group teams</h2>
            <a class="btn btn-outline" asp-action="AddGroupTeam" asp-route-id="@Model.Id"><hero-icon name="plus" class="size-4"></hero-icon>Add team</a>
        </div>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table dataTable" id="teams-table">
                <thead><tr><th scope="col">Name</th><th scope="col">Slug</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Teams)
                {
                    <tr>
                        <td class="font-semibold">@item.Team.Name</td><td><code>@item.Team.Slug</code></td>
                        <td class="text-right"><form asp-action="RemoveGroupTeam" asp-route-id="@item.Id" asp-route-groupId="@item.GroupId"><button type="submit" class="btn btn-sm btn-ghost text-error" aria-label="Remove @item.Team.Name from group">Remove</button></form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
@section Scripts {
    @await Html.PartialAsync("_CommonReportScripts")


    <script type="text/javascript">

        $('.table').DataTable({
            "columnDefs": [
                { "orderable": false, "targets": -1}
            ]
        });

    </script>

}

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
