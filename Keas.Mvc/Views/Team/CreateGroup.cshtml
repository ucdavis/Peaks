@model Keas.Core.Domain.Group
@{ ViewData["Title"] = "Create group"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Create group</h1>
            <p class="m-0 text-base-content/70">Create a reporting group for multiple teams.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-action="Index" asp-controller="Admin" ><hero-icon name="arrow-left" class="size-4"></hero-icon>Administration</a></div>
    </div>
    <form asp-action="CreateGroup" class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>

        <div class="space-y-2">
            <label asp-for="Name" class="block text-sm font-semibold"></label>
            <input asp-for="Name" class="input w-full" />
            <span asp-validation-for="Name" class="block text-sm text-error"></span>

        </div>

        <div class="flex flex-wrap gap-2 border-t border-main-border pt-5">
            <button type="submit" class="btn btn-primary">Create group</button>
            <a class="btn btn-ghost" asp-action="Index" asp-controller="Admin">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}
