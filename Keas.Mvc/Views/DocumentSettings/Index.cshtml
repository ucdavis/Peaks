@model TeamDocumentSettingsModel
@{ ViewData["Title"] = "DocuSign settings"; }
<div class="space-y-8 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">DocuSign settings</h1>
            <p class="m-0 text-base-content/70">Choose a signing account and review its shared templates.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="TeamAdmin" asp-action="Index"><hero-icon name="arrow-left" class="size-4"></hero-icon>Team settings</a></div>
    </div>
    <details class="rounded-sm border border-main-border bg-base-100 p-5">
        <summary class="cursor-pointer font-semibold">DocuSign setup instructions</summary>
        <div class="mt-5 max-w-4xl space-y-4 text-sm leading-6"><h3 class="m-0 text-lg font-semibold">Familiar with DocuSign Already?</h3>
                      <p>You need to create a template with a single recipient who's role is "signer" and share the template with the PEAKS group.</p>
                      <h3 class="m-0 text-lg font-semibold">Basic Instructions</h3>
                      <p>You can find detailed instructions in CRU's Peaks <a target="_blank" rel="noopener noreferrer" href="https://computing.caes.ucdavis.edu/documentation/peaks/docusign-documents">DocuSign Documents</a> Document.
                          It essentially boils down to the following steps...</p>
                      <ol class="list-decimal space-y-2 ps-5">
                          <li>
                              Login to <a href="https://app.docusign.com/home" target="_blank" rel="noopener noreferrer">docusign.com</a> and choose "Templates" from the top menu.
                              If you do not see that option, <a href="https://itcatalog.ucdavis.edu/service/docusign-pilot" target="_blank" rel="noopener noreferrer">request access here</a>
                          </li>
                          <li>Click "New" and create a template</li>
                          <li>Give the template and name and then add the documents that need signing</li>
                          <li>In the "Add Recipients" section, <strong> in the "Role" field type "signer" This is case sensitive and must be as shown</strong>. Do not fill in name or email, and do not add any more recipients</li>
                          <li>If you would like to you can customize the email subject and message that will be sent out when the system requests their signature</li>
                          <li>Click "Next" and setup the document for signing as desired, ex: placing their signature and date signed at the bottom</li>
                          <li>Click "Save and Close"</li>
                          <li>Back at the list of templates, select the dropdown next to your template and choose "Share with Users" and <strong>choose GROUPS and select PEAKS and then click share</strong></li>
                          <li>And finally, click on the template name to navigate to the template details page.</li>
                      </ol>
                      <p>Templates created in this manner should be listed in Peaks' Assign Document dialog the next time the User Details page is visited.</p>
</div>
    </details>
    <section class="space-y-4" aria-labelledby="selected-account-heading">
        <h2 id="selected-account-heading" class="m-0 text-xl font-bold">Selected account</h2>
        @if (Model.TeamAccount?.AccountId == null)
        {
            <div role="alert" class="alert alert-info"><hero-icon name="information-circle" class="size-5"></hero-icon><span>Select a DocuSign account below to access its shared templates.</span></div>
        }
        else
        {
            <dl class="m-0 grid gap-5 rounded-sm border border-main-border bg-base-100 p-5 md:grid-cols-3">
                <div><dt class="text-sm text-base-content/60">Account name</dt><dd class="m-0 mt-1 font-semibold">@Model.TeamAccount.AccountName</dd></div>
                <div><dt class="text-sm text-base-content/60">Account ID</dt><dd class="m-0 mt-1 break-all font-mono text-sm">@Model.TeamAccount.AccountId</dd></div>
                <div><dt class="text-sm text-base-content/60">API base URL</dt><dd class="m-0 mt-1 break-all text-sm">@Model.TeamAccount.ApiBasePath</dd></div>
            </dl>
        }
    </section>
    <section class="space-y-4" aria-labelledby="accounts-heading">
        <h2 id="accounts-heading" class="m-0 text-xl font-bold">Available accounts</h2>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table" id="accounts-table">
                <thead><tr><th scope="col">Account name</th><th scope="col">Account ID</th><th scope="col">API base URL</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.AvailableAccounts)
                {
                    <tr>
                        <td class="font-semibold">@item.AccountName</td><td>@item.AccountId</td><td>@item.ApiBasePath</td>
                        <td class="text-right"><form asp-action="SelectAccount" method="post">
                            <input name="AccountId" type="hidden" value="@item.AccountId" />
                            <button type="submit" class="btn btn-sm btn-outline" aria-label="Select @item.AccountName">Select account</button>
                        </form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    @if (Model.TeamAccount?.AccountId != null)
    {
        <section class="space-y-4" aria-labelledby="templates-heading">
            <div class="space-y-2"><h2 id="templates-heading" class="m-0 text-xl font-bold">Shared templates</h2><p class="m-0 text-sm text-base-content/70">Templates available and shared for the selected account.</p></div>
            <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
                <table class="table" id="templates-table">
                    <thead><tr><th scope="col">Template name</th><th scope="col">Template ID</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.TemplateNames)
                    {
                        <tr><td class="font-medium">@item.Name</td><td>@item.Id</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
@section Scripts {
    @await Html.PartialAsync("_CommonReportScripts")
    <script>
        $('#templates-table').DataTable();
        $('#accounts-table').DataTable({columnDefs: [{ targets: -1, orderable: false }]});
    </script>
}
