@using Keas.Core.Extensions

@model Keas.Mvc.Models.ReportModels.EquipmentHistoryModel

@{
    ViewBag.Title = "Equipment";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Equipment History Report for @Html.DisplayFor(m => m.Equipment.Name)</h1>
        </div>
    </div>
    <div class="space-y-4">
        <p><b>@Html.DisplayNameFor(m => m.Equipment.SerialNumber)</b></p>
                <p>@Html.DisplayFor(m => m.Equipment.SerialNumber)</p>
                <p><b>@Html.DisplayNameFor(m => m.Equipment.Make)</b></p>
                <p>@Html.DisplayFor(m => m.Equipment.Make)</p>
                <p><b>@Html.DisplayNameFor(m => m.Equipment.Model)</b></p>
                <p>@Html.DisplayFor(m => m.Equipment.Model)</p>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="history" class="table dataTable">
            <thead>
                <tr>
                    <th>Action Date</th>
                    <th>Action</th>
                    <th>Actor</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Histories)
                {
                    <tr>
                        <td>@item.ActedDate.ToPacificTime()</td>
                        <td>@item.ActionType</td>
                        <td>@item.ActorId</td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
@await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
@{await Html.RenderPartialAsync("_ImportJS");}

<script type="text/javascript">
    $('.dataTable').DataTable({
        "layout": { topStart: ['pageLength', 'buttons'] },
        "buttons": [
            { extend: 'copyHtml5' },
            { extend: 'excelHtml5' },
            { extend: 'csvHtml5' },
            { extend: 'print' },
        ],
        "order": [[0, "desc"]],
        "columnDefs": [
            { "type": "date", "targets": [0] },
        ]
    });
</script>
}
