@using Keas.Core.Extensions;
@model Keas.Mvc.Models.ReportModels.AdminHistoryReportViewModel
@{ ViewData["Title"] = "Admin Action History"; }

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Admin Action History</h1>
        </div>
    </div>
    <div class="space-y-4">
        <form class="space-y-5" asp-action="ActionsByAdmins" method="get">
                    <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
                    <div class="grid items-start gap-6 lg:grid-cols-2">
                        <div class="min-w-0 space-y-3">
                            <h2 class="m-0 text-lg font-semibold">Filters</h2>
                            <div class="space-y-2">
                                <div class="space-y-2">
                                    <label asp-for="Start" class="block text-sm font-semibold"></label>
                                    <input id="start" asp-for="Start" class="input w-full" />
                                    <span asp-validation-for="Start" class="text-sm text-error"></span>
                                </div>
                                <div class="space-y-2">
                                    <label asp-for="End" class="block text-sm font-semibold"></label>
                                    <input id="end" asp-for="End" class="input w-full" />
                                    <span asp-validation-for="End" class="text-sm text-error"></span>
                                </div>
                                <div class="space-y-2">
                                    <label asp-for="PersonId" class="block text-sm font-semibold"></label>
                                    <select asp-for="PersonId" class="select w-full" asp-items="@(new SelectList(Model.Admins, "Id", "Name"))"></select>
                                </div>
                                <div class="space-y-2">
                                    <input type="submit" value="Refresh Report" class="btn btn-primary" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="adminActions" class="table dataTable">
            <thead>
                <tr>
                    <th>
                        Asset
                    </th>
                    <th>
                        Action
                    </th>
                    <th>
                        ActorId
                    </th>
                    <th>
                        Date
                    </th>
                    <th>
                        Description
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Histories != null)
                {
                    foreach (var item in Model.Histories)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => item.AssetType)</td>
                            <td>@Html.DisplayFor(a => item.ActionType)</td>
                            <td>@Html.DisplayFor(a => item.ActorId)</td>
                            <td>@item.ActedDate.ToPacificTime().ToString("d")</td>
                            <td>
                                @Html.DisplayFor(a=> item.Description)
                            </td>
                            <td>
                                @if (item.Link != null)
                                {
                                    <a href='@($"/{Model.TeamSlug}{item.Link}")' target="_blank">Details</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ImportJS");
    }

    <script type="text/javascript">
        $('.dataTable').DataTable({
            "layout": { topStart: ['pageLength', 'buttons'] },
            "buttons": [
                { extend: 'copyHtml5' },
                { extend: 'excelHtml5' },
                { extend: 'csvHtml5' },
                { extend: 'print' },
            ],
            "columnDefs": [
                { "type": "date", "targets": [3] }
            ]
        });
    </script>
}
