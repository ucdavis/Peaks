@using Keas.Core.Extensions
@model System.Collections.Generic.IList<Keas.Mvc.Models.ReportModels.KeyReportModel>

@{
    ViewBag.Title = "Key Space Report";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Keys With Spaces Report</h1>
        </div>
    </div>
    <div class="space-y-4">
        <h2 class="m-0 text-lg font-semibold"><hero-icon name="information-circle" class="size-4"></hero-icon> Instructions</h2>
                                <ul class="m-0 list-disc space-y-1 ps-5 text-sm text-base-content/70">

                                    <li>
                                        To see more details, export the results with one of the buttons on the table (Copy, Excel, etc.).
                                    </li>
                                    <li>
                                        If you have filtered the report with the Search feature, only the filtered results will be exported.
                                    </li>
                                    <li>
                                        You can filter the table with the data that isn't displayed on the screen (such as notes).
                                    </li>
                                </ul>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="access" class="table dataTable">
            <thead>
                <tr>
                    <th>Key Name</th>
                    <th>Code</th>
                    <th>Active</th>
                    <th># Serials</th>
                    <th># Spaces</th>
                    <th>Notes?</th>
                    <th>Tags</th>
                    <th>Notes</th>
                    <th>Room Number</th>
                    <th>Building</th>
                    <th>Room Name</th>
                    <th>Floor</th>
                    <th>Category</th>
                    <th>Footage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    if (item.SpacesCount > 0)
                    {
                        foreach (var space in item.Spaces)
                        {
                            <tr>
                                <td>@item.KeyName</td>
                                <td>@item.Code</td>
                                <td>@item.Active.ToYesNoString()</td>
                                <td>@item.KeySerialCount</td>
                                <td>@item.SpacesCount</td>
                                <td>@((!string.IsNullOrWhiteSpace(item.Notes)).ToYesNoString())</td>
                                <td>@item.Tags.Replace(",", ", ")</td>
                                <td>@item.Notes</td>
                                <td>@space.RoomNumber</td>
                                <td>@space.BldgName</td>
                                <td>@space.RoomName</td>
                                <td>@space.FloorName</td>
                                <td>@space.RoomCategoryName</td>
                                <td>@space.SqFt</td>
                            </tr>
                        }
                    }
                    else
                    {
                            <tr>
                                <td>@item.KeyName</td>
                                <td>@item.Code</td>
                                <td>@item.Active.ToYesNoString()</td>
                                <td>@item.KeySerialCount</td>
                                <td>@item.SpacesCount</td>
                                <td>@((!string.IsNullOrWhiteSpace(item.Notes)).ToYesNoString())</td>
                                <td>@item.Tags.Replace(",", ", ")</td>
                                <td>@item.Notes</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                }

            }
                </tbody>
            </table>
    </div>
</div>

@section Styles {
        @await Html.PartialAsync("_ReportStylePartial")
    }
    @section Scripts {
        @{await Html.RenderPartialAsync("_ImportJS");}

        <script type="text/javascript">
            $('.dataTable').DataTable({
                "layout": { topStart: ['pageLength', 'buttons'] },
                "buttons": [
                    { extend: 'copyHtml5' },
                    { extend: 'excelHtml5' },
                    { extend: 'csvHtml5' },
                    { extend: 'print' },
                ],
                "order": [[0, "asc"], [1, "asc"], [2, "asc"]],
                "columnDefs": [
                    { "targets": [3,7,10,11,12,13], "visible": false },
                ]
            });
        </script>
    }
