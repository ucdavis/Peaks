@using Keas.Core.Extensions
@model Keas.Mvc.Models.ReportModels.CompletedDocsReportModel

@{
    ViewData["Title"] = "Completed Documents";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Completed Documents</h1>
        </div>
    </div>
    <div class="space-y-4">
        <form class="space-y-5" asp-action="CompletedDocuments" method="get">

                    <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
                    <div class="grid items-start gap-6 lg:grid-cols-2">
                        <div class="min-w-0 space-y-3">
                            <h2 class="m-0 text-lg font-semibold">Filters</h2>
                            <div class="space-y-2">
                                <label asp-for="Start" class="block text-sm font-semibold"></label>
                                <input asp-for="Start" class="input w-full datepicker"/>
                                <span asp-validation-for="Start" class="text-sm text-error"></span>
                                <label asp-for="End" class="block text-sm font-semibold"></label>
                                <input asp-for="End" class="input w-full datepicker"/>
                                <span asp-validation-for="End" class="text-sm text-error"></span>
                                <div class="space-y-2">
                                    <input type="submit" value="Refresh Report" class="btn btn-primary" />
                                </div>
                            </div>
                        </div>
                    </div>

        </form>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="dtDocuments" class="table dataTable">
                <thead>
                <tr>
                    <th>
                        Person
                    </th>
                    <th>
                        Doc Name
                    </th>
                    <th>
                        Created
                    </th>
                    <th>
                        Completed
                    </th>
                    <th>
                        Link
                    </th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.PersonName</td>
                        <td>@item.DocName</td>
                        <td>@Html.DisplayFor(a => item.CreatedAt)</td>
                        <td>@Html.DisplayFor(a => item.CompletedAt)</td>
                        <td>
                            <a href='@item.DetailsLink' target="_blank">Details</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ImportJS");}

    <script type="text/javascript">
        $('.dataTable').DataTable({
            "layout": { topStart: ['pageLength', 'buttons'] },
            "buttons": [
                { extend: 'copyHtml5' },
                { extend: 'excelHtml5' },
                { extend: 'csvHtml5' },
                { extend: 'print'},
            ],
            "columnDefs": [
                { "type": "date", "targets": [2,3] }
            ]
        });
    </script>
}
