@using Keas.Mvc.Models.ReportModels
@model System.Collections.Generic.List<InactiveSpaceReportModel>
@{
    ViewBag.Title = "Inactive Spaces";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Inactive Spaces Report</h1>
        </div>
    </div>
    <div class="space-y-4">
        <div class="grid items-start gap-6 lg:grid-cols-2">
                    <div class="min-w-0 space-y-3">
                        <h2 class="m-0 text-lg font-semibold"><hero-icon name="information-circle" class="size-4"></hero-icon> Instructions</h2>
                        <ul class="m-0 list-disc space-y-1 ps-5 text-sm text-base-content/70">
                            <li>
                                This report displays all inactive spaces that have active assets associated with them
                            </li>
                            <li>
                                If you have filtered the report with the Search feature, only the filtered results will be exported.
                            </li>
                        </ul>
                    </div>
                </div>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="inactive" class="table dataTable">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Room Name</th>
                    <th>Equipment Count</th>
                    <th>Key Count</th>
                    <th>WorkStation Count</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(a => item.Room)
                        </td>
                        <td>
                            @Html.DisplayFor(a => item.RoomName)
                        </td>
                        <td>
                            @Html.DisplayFor(a => item.EquipmentCount)
                        </td>
                        <td>
                            @Html.DisplayFor(a => item.KeyCount)
                        </td>
                        <td>
                            @Html.DisplayFor(a => item.WorkStationCount)
                        </td>
                        <td>
                            <a href="@item.DetailsLink" target="_blank">Details</a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

    @section Scripts {
    @{
        await Html.RenderPartialAsync("_ImportJS");
    }

    <script type="text/javascript">
        $('.dataTable').DataTable({
            "layout": { topStart: ['pageLength', 'buttons'] },
            "buttons": [
                { extend: 'copyHtml5' },
                { extend: 'excelHtml5' },
                { extend: 'csvHtml5' },
                { extend: 'print' },
            ],
            "columnDefs": [
                {
                    targets: -1,
                    orderable: false,
                },
            ]
        });
    </script>
}
