@model Keas.Mvc.Models.ReportModels.KeyValueReportViewModel

@{
    ViewData["Title"] = "Key/Values used by Team";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Key/Value Pairs in Equipment</h1>
        </div>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table class="table dataTable">
            <thead>
                <tr>
                    <th>
                        Key
                    </th>
                    <th>
                        Used Count
                    </th>
                    <th>In Lookup List?</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pair in Model.KeyPairs)
                {
                    <tr>
                        <td>@pair.Key</td>
                        <td>@pair.Count</td>
                        <td>@pair.FoundInEquipmentAttributeKeys.ToYesNoString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
    @await Html.PartialAsync("_CommonReportScripts")


    <script type="text/javascript">
        $('.dataTable').DataTable();

    </script>
}
