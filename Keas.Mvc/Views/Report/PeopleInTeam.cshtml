@using Microsoft.CodeAnalysis.Operations
@model PeopleInTeamReportViewModel

@{
    ViewData["Title"] = "People In Team";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">People In Team Report</h1>
        </div>
    </div>
    <div class="space-y-4">
        <form class="space-y-5" asp-action="PeopleInTeam" method="get">

            <div class="grid items-start gap-6 lg:grid-cols-2">
                <div class="min-w-0 space-y-3">
                    <h2 class="m-0 text-lg font-semibold"><hero-icon name="information-circle" class="size-4"></hero-icon> Instructions</h2>
                    <ul class="m-0 list-disc space-y-1 ps-5 text-sm text-base-content/70">

                        <li>
                            To see more details, export the results with one of the buttons on the table (Copy, Excel, etc.).
                        </li>
                        <li>
                            If you have filtered the report with the Search feature, only the filtered results will be exported.
                        </li>
                        <li>
                            You can filter the table with the data that isn't displayed on the screen (such as notes).
                        </li>
                    </ul>
                </div>
                <div class="min-w-0 space-y-3">
                    <h2 class="m-0 text-lg font-semibold">Filters</h2>
                    <div class="space-y-2">
                        <label asp-for="HideInactive" class="text-sm font-medium"></label>
                        <input asp-for="HideInactive" class="checkbox checkbox-sm align-middle" />
                    </div>
                    <input type="submit" value="Refresh Report" class="btn btn-primary" />
                </div>
            </div>

        </form>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table class="table dataTable">
    <thead>
    <tr>
        <th>
            Id
        </th>
        <th>
            Active
        </th>
        <th>
            Login Id
        </th>
        <th>
            First Name
        </th>
        <th>
            Last Name
        </th>
        <th>
            Person Email
        </th>
        <th>
            Tags
        </th>
        <th>
            Title
        </th>
        <th>
            Home Phone
        </th>
        <th>
            Team Phone
        </th>
        <th>
            Supervisor
        </th>
        <th>
            Start Date
        </th>
        <th>
            End Date
        </th>
        <th>
            Category
        </th>
        <th>
            Notes
        </th>

        <th>
            User Email
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.PeopleList) {
        <tr>
            <td>
                @item.Id
            </td>
            <td>
                @item.Active.ToYesNoString()
            </td>
            <td>
                @item.UserId
            </td>
            <td>
                @item.FirstName
            </td>
            <td>
                @item.LastName
            </td>
            <td>
                @item.Email
            </td>
            <td>
                @item.Tags
            </td>
            <td>
                @item.Title
            </td>
            <td>
                @item.HomePhone
            </td>
            <td>
                @item.TeamPhone
            </td>
            <td>
                @(item.SupervisorId.HasValue ? item.Supervisor.Name: string.Empty)
            </td>
            <td>
                @item.StartDate
            </td>
            <td>
                @item.EndDate
            </td>
            <td>
                @item.Category
            </td>
            <td>
                @item.Notes
            </td>
            <td>
                @item.User.Email
            </td>
            <td>
            @if (item.Active)
            {
                <a href='@string.Format("/{0}/{1}/details/{2}", TempData["TeamName"], "People", item.Id)' target="_blank">Details</a>
            }
            </td>
        </tr>
    }
    </tbody>
</table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ImportJS");}

    <script type="text/javascript">
        $('.dataTable').DataTable({
            "layout": { topStart: ['pageLength', 'buttons'] },
            "buttons": [
                { extend: 'copyHtml5' },
                { extend: 'excelHtml5' },
                { extend: 'csvHtml5' },
                { extend: 'print'},
            ],
            "columnDefs": [
                { "type": "date", "targets": [11,12] },
                { "targets" : [ 0,2,7,8,9,14,15], "visible" : false}
            ]
        });
    </script>
}
