@using Keas.Core.Extensions
@model System.Collections.Generic.IList<Keas.Mvc.Models.ReportModels.AccessReportModel>

@{
    ViewBag.Title = "Access";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Access Report</h1>
        </div>
    </div>
    <div class="space-y-4">
        <h2 class="m-0 text-lg font-semibold"><hero-icon name="information-circle" class="size-4"></hero-icon> Instructions</h2>
                                <ul class="m-0 list-disc space-y-1 ps-5 text-sm text-base-content/70">

                                    <li>
                                        To see more details, export the results with one of the buttons on the table (Copy, Excel, etc.).
                                    </li>
                                    <li>
                                        If you have filtered the report with the Search feature, only the filtered results will be exported.
                                    </li>
                                    <li>
                                        You can filter the table with the data that isn't displayed on the screen (such as notes).
                                    </li>
                                </ul>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="access" class="table dataTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Active</th>
                    <th># Assigned</th>
                    <th>Notes?</th>
                    <th>Tags</th>
                    <th>Notes</th>
                    <th>Assigned To</th>
                    <th>Email</th>
                    <th>Expires</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    if (item.AssignmentCount > 0)
                    {
                        foreach (var assignment in item.Assignments)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Active.ToYesNoString()</td>
                                <td>@item.AssignmentCount</td>
                                <td>@((!string.IsNullOrWhiteSpace(item.Notes)).ToYesNoString())</td>
                                <td>@item.Tags.Replace(",", ", ")</td>
                                <td>@item.Notes</td>
                                <td>@assignment.NameAndUserId</td>
                                <td>@assignment.Email</td>
                                <td>@assignment.ExpiryDateTime.ToPacificTime().ToShortDateString()</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Active.ToYesNoString()</td>
                            <td>@item.AssignmentCount</td>
                            <td>@((!string.IsNullOrWhiteSpace(item.Notes)).ToYesNoString())</td>
                            <td>@item.Tags.Replace(",", ", ")</td>
                            <td>@item.Notes</td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                    }

                @*  *@}
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
@section Scripts {
    @{await Html.RenderPartialAsync("_ImportJS");}

    <script type="text/javascript">
        $('.dataTable').DataTable({
            "layout": { topStart: ['pageLength', 'buttons'] },
            "buttons": [
                { extend: 'copyHtml5' },
                { extend: 'excelHtml5' },
                { extend: 'csvHtml5' },
                { extend: 'print' },
            ],
            "columnDefs": [
                { "type": "date", "targets": [8] },
                { "targets" : [ 5], "visible" : false},
            ]
        });
    </script>
}
