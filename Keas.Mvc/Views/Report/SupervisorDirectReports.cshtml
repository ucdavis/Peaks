@model Keas.Mvc.Models.ReportModels.SupervisorReportViewModel
@{ ViewData["Title"] = "Supervisor Direct Reports"; }

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Supervisor Direct Reports</h1>
        </div>
    </div>
    <div class="space-y-4">
        <form class="space-y-5" asp-action="SupervisorDirectReports" method="get">

                    <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
                        <div class="grid items-start gap-6 lg:grid-cols-2">
                            <div class="min-w-0 space-y-3">
                                <h2 class="m-0 text-lg font-semibold">Filters</h2>
                                <div class="space-y-2">
                                    <label asp-for="PersonId" class="block text-sm font-semibold"></label>
                                     <select asp-for="PersonId" class="select w-full" asp-items="@(new SelectList(Model.Supervisors, "Id", "Name"))"></select>
                                     <div class="space-y-2">
                                    <input type="submit" value="Refresh Report" class="btn btn-primary" />
                                </div>
                                </div>
                            </div>
                        </div>

        </form>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="dtDirectReports" class="table dataTable">
        <thead>
        <tr>
            <th>
               Name
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Reports != null)
        {
        foreach (var item in Model.Reports)
        {
            <tr>
                <td>
                    @Html.DisplayFor(a=> item.LastName), @Html.DisplayFor(a=> item.FirstName)
                </td>
                <td>
                    <a href='@string.Format("/{0}/{1}/details/{2}", TempData["TeamName"], "People", item.Id)'>Details</a>
                </td>
            </tr>
        }
        }
        </tbody>
    </table>
    </div>
</div>
