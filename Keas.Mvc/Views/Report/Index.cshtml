@model string[]
@using Keas.Core.Domain

@{
    ViewData["Title"] = "Reports";
}
<div class="card">
    <div class="card-header-primary">
        <div class="row justify-content-between">
          <div class="card-head">
            <h2><hero-icon name="clipboard-document-list" class="size-4"></hero-icon> Reports</h2>
          </div>
        </div>
      </div>
      <div class="card-content">
        <div class="row">
            @if (Model.Contains(Role.Codes.EquipmentMaster) || Model.Contains(Role.Codes.DepartmentalAdmin))
            {
            <div class="report-list equipment-color col-md-3">
                <h3><hero-icon name="computer-desktop" class="size-4"></hero-icon> Equipment Reports</h3>
                <ul>
                    <li>
                        <a asp-action="EquipmentReport">View All <span style="white-space: nowrap;">Equipment <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="EquipmentReportV2">View All Equipment <span style="white-space: nowrap;">V2 <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="KeyValues">Key/Value Pairs in <span style="white-space: nowrap;">Equipment <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                </ul>
            </div>
        }
        <div class="report-list people-color col-md-3">
            <h3><hero-icon name="users" class="size-4"></hero-icon> People Reports</h3>
                <ul>
                    <li>
                        <a asp-action="SupervisorDirectReports">Direct Reports by <span style="white-space: nowrap;">Supervisor <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="PersonActions">Actions Taken Against People in <span style="white-space: nowrap;">Team <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="PeopleInTeam">People in <span style="white-space: nowrap;">Team <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="PeopleLeavingWithAssets">People Leaving With <span style="white-space: nowrap;">Assets <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    @if (Model.Contains(Role.Codes.DepartmentalAdmin))
                    {
                        <li>
                            <a asp-action="ActionsByAdmins">Admin Action <span style="white-space: nowrap;">History <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                        </li>
                    }
                </ul>
        </div>
        @if (Model.Contains(Role.Codes.SpaceMaster) || Model.Contains(Role.Codes.DepartmentalAdmin))
        {
            <div class="report-list spaces-color col-md-3">
                <h3><hero-icon name="building-office-2" class="size-4"></hero-icon> Workstations Reports</h3>
                    <ul>
                        <li>
                        <a asp-action="WorkstationReport">View All <span style="white-space: nowrap;">Workstations <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                        </li>
                    </ul>
            </div>
        }
        @if (Model.Contains(Role.Codes.AccessMaster) || Model.Contains(Role.Codes.DepartmentalAdmin))
        {
            <div class="report-list access-color col-md-3">
                <h3><hero-icon name="identification" class="size-4"></hero-icon> Access Reports</h3>
                <ul>
                    <li>
                        <a asp-action="AccessReport">View All <span style="white-space: nowrap;">Access <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                </ul>
            </div>
        }

        @if (Model.Contains(Role.Codes.KeyMaster) || Model.Contains(Role.Codes.DepartmentalAdmin))
        {
            <div class="report-list keys-color col-md-3">
                <h3><hero-icon name="key" class="size-4"></hero-icon> Keys Reports</h3>
                <ul>
                    <li>
                        <a asp-action="KeyReport">View All <span style="white-space: nowrap;">Keys <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="KeyWithSerialReport">Keys With <span style="white-space: nowrap;">Serials <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                    <li>
                        <a asp-action="KeyWithSpaceReport">Keys With <span style="white-space: nowrap;">Spaces <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                </ul>
            </div>
        }
        @if (Model.Contains(Role.Codes.DocumentMaster) || Model.Contains(Role.Codes.DepartmentalAdmin))
        {
                <div class="report-list documents-color col-md-3">
                    <h3><hero-icon name="document-text" class="size-4"></hero-icon> Documents Reports</h3>
                    <ul>
                        <li>
                            <a asp-action="PeopleWithIncompleteDocuments">People with Unsigned <span style="white-space: nowrap;">Documents <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                        </li>
                        <li>
                            <a asp-action="CompletedDocuments">Completed <span style="white-space: nowrap;">Documents <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                        </li>
                    </ul>
                </div>
        }
        <div class="report-list general-color col-md-3">
            <h3><hero-icon name="list-bullet" class="size-4"></hero-icon> General Reports</h3>
            <ul>
                <li>
                    <a asp-action="ExpiringItems">Expiring <span style="white-space: nowrap;">Items <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                </li>
                @if (Model.Contains(Role.Codes.EquipmentMaster) || Model.Contains(Role.Codes.DepartmentalAdmin) || Model.Contains(Role.Codes.KeyMaster) || Model.Contains(Role.Codes.SpaceMaster))
                {
                    <li>
                        <a asp-action="UnAcceptedItems">Items Pending <span style="white-space: nowrap;">Acceptance <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                }
                <li>
                    <a asp-action="InActiveSpaces">InActive Spaces With <span style="white-space: nowrap;">Assets <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                </li>
            </ul>
            </div>
        </div>
      </div>
    </div>
