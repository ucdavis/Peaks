@using Keas.Core.Extensions
@model Keas.Mvc.Models.ReportModels.ReportPersonNotifyViewModel
@{
    ViewData["Title"] = "Person Actions";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Person Actions</h1>
        </div>
    </div>
    <div class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
                <div class="grid items-start gap-6 lg:grid-cols-2">
                    <div class="min-w-0 space-y-3">
                    <form class="space-y-5" asp-action="PersonActions" method="get">

                                <h2 class="m-0 text-lg font-semibold">Filters</h2>
                                  <div class="space-y-2">
                                      <label asp-for="StartDate" class="block text-sm font-semibold"></label>
                                      <input id="start" asp-for="StartDate" class="input w-full" />
                                      <span asp-validation-for="StartDate" class="text-sm text-error"></span>
                                  </div>
                                   <div class="space-y-2">
                                      <label asp-for="EndDate" class="block text-sm font-semibold"></label>
                                      <input id="end" asp-for="EndDate" class="input w-full" />
                                      <span asp-validation-for="EndDate" class="text-sm text-error"></span>
                                  </div>
                                  <div class="space-y-2">
                                    <input type="submit" value="Refresh Report" class="btn btn-primary" />
                                  </div>
                                  </form>
                                  </div>

                        </div>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table id="persons-acted-on" class="table dataTable">
        <thead>
        <tr>
            <th>Person</th>
            <th>Person Email</th>
            <th>Actor</th>
            <th>Date</th>
            <th>Action</th>
            <th>Notes</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.PersonNotifications)
        {
            <tr>
                <td>@item.PersonName</td>
                <td>@item.PersonEmail</td>
                <td>@item.ActorName (@item.ActorId)</td>
                <td>@item.ActionDate.ToPacificTime()</td>
                <td>@item.Action</td>
                <td>@item.Notes</td>
            </tr>
        }

        </tbody>
    </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
    @await Html.PartialAsync("_CommonReportScripts")


    <script type="text/javascript">
        $('#start').datepicker({
            uiLibrary: 'bootstrap4',
            format: 'yyyy-mm-dd'
        });
        $('#end').datepicker({
            uiLibrary: 'bootstrap4',
            format: 'yyyy-mm-dd'
        });
        $('.dataTable').DataTable({
            "columnDefs": [
                { "type": "date", "targets": [3] },
            ],
            "order": [[ 3, "desc" ]]
        });

    </script>
}
