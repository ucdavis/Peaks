@using Keas.Core.Models
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model Keas.Mvc.Models.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
    var teamSlug = TempData["TeamName"] as string;
    var isTeamAdmin = (await AuthorizationService.AuthorizeAsync(User, AccessCodes.Codes.DepartmentAdminAccess)).Succeeded;
    var hasAssetRole = (await AuthorizationService.AuthorizeAsync(User, AccessCodes.Codes.AnyRole)).Succeeded;
}

<div class="space-y-8 pb-8">
    <header class="space-y-2">
        @await Html.PartialAsync("_ActiveTeamEyebrow")
        <h1 class="m-0 text-3xl font-semibold text-base-content">Welcome to PEAKS, @User.GetNameClaim()</h1>
        <p class="m-0 text-lg text-base-content/70">View your assignments and manage your team's assets.</p>
    </header>

    @if (Model.PendingItems)
    {
        <section aria-label="Pending assignments">
            @if (Model.TeamsWithPendingAssignments.Any(team => team.Slug != null && team.Slug == teamSlug))
            {
                <div class="alert alert-info mb-4">
                    <hero-icon variant="outline" name="squares-2x2" class="size-6"></hero-icon>
                    <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                        <p class="m-0 font-bold">You have pending items!</p>
                        <a asp-controller="Confirm" asp-action="Confirm" class="link link-hover inline-flex items-center gap-2">
                            Go to Accept page <hero-icon variant="outline" name="arrow-right" class="size-4"></hero-icon>
                        </a>
                    </div>
                </div>
            }
            @if (Model.TeamsWithPendingAssignments.Any(team => team.Slug != teamSlug))
            {
                <h2 class="mb-3 text-lg font-semibold">You have items pending in other teams:</h2>
                @foreach (var team in Model.TeamsWithPendingAssignments.Where(team => team.Slug != teamSlug))
                {
                    <div class="alert alert-info mb-4">
                        <hero-icon variant="outline" name="squares-2x2" class="size-6"></hero-icon>
                        <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                            <p class="m-0 font-bold">You have pending items in team @team.Name!</p>
                            <a href="/@team.Slug/Confirm/Confirm" class="link link-hover inline-flex items-center gap-2">
                                Go to Accept page <hero-icon variant="outline" name="arrow-right" class="size-4"></hero-icon>
                            </a>
                        </div>
                    </div>
                }
            }
        </section>
    }

    <section aria-labelledby="quick-actions-heading" class="space-y-4">
        <h2 id="quick-actions-heading" class="m-0 text-2xl font-semibold text-base-content">Quick Actions</h2>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <a asp-controller="Confirm" asp-action="MyStuff" class="group block rounded-sm border border-main-border bg-base-100 p-5 text-base-content transition hover:bg-base-200 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                <div class="mb-4 flex items-start justify-between gap-3">
                    <hero-icon variant="outline" name="briefcase" class="size-6"></hero-icon>
                    <hero-icon name="arrow-right" class="size-5 text-base-content/40 group-hover:text-primary"></hero-icon>
                </div>
                <h3 class="m-0 text-xl font-semibold">MyStuff</h3>
                <p class="mb-0 mt-2 text-sm leading-6 text-base-content/70">View your assigned keys, equipment, access, workstations, and documents.</p>
            </a>
            @if (isTeamAdmin)
            {
                <a asp-controller="TeamAdmin" class="group block rounded-sm border border-main-border bg-base-100 p-5 text-base-content transition hover:bg-base-200 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                    <div class="mb-4 flex items-start justify-between gap-3">
                        <hero-icon variant="outline" name="trophy" class="size-6"></hero-icon>
                        <hero-icon name="arrow-right" class="size-5 text-base-content/40 group-hover:text-primary"></hero-icon>
                    </div>
                    <h3 class="m-0 text-xl font-semibold">Administer Team</h3>
                    <p class="mb-0 mt-2 text-sm leading-6 text-base-content/70">Manage your team's settings, permissions, and imports.</p>
                </a>
            }
            @if (hasAssetRole)
            {
                <a href="/@teamSlug/People" class="group block rounded-sm border border-main-border bg-base-100 p-5 text-base-content transition hover:bg-base-200 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                    <div class="mb-4 flex items-start justify-between gap-3">
                        <hero-icon variant="outline" name="squares-2x2" class="size-6"></hero-icon>
                        <hero-icon name="arrow-right" class="size-5 text-base-content/40 group-hover:text-primary"></hero-icon>
                    </div>
                    <h3 class="m-0 text-xl font-semibold">Team Assets</h3>
                    <p class="mb-0 mt-2 text-sm leading-6 text-base-content/70">Browse your team's people and their asset assignments.</p>
                </a>
            }
        </div>
    </section>

    @if (hasAssetRole)
    {
        var canViewEquipment = isTeamAdmin || (await AuthorizationService.AuthorizeAsync(User, AccessCodes.Codes.EquipMasterAccess)).Succeeded;
        var canViewAccess = isTeamAdmin || (await AuthorizationService.AuthorizeAsync(User, AccessCodes.Codes.AccessMasterAccess)).Succeeded;
        var canViewKeys = isTeamAdmin || (await AuthorizationService.AuthorizeAsync(User, AccessCodes.Codes.KeyMasterAccess)).Succeeded;
        var canViewSpaces = canViewEquipment || canViewAccess || canViewKeys || (await AuthorizationService.AuthorizeAsync(User, AccessCodes.Codes.SpaceMasterAccess)).Succeeded;

        <section aria-labelledby="browse-assets-heading" class="space-y-4">
            <h2 id="browse-assets-heading" class="m-0 text-2xl font-semibold text-base-content">Browse Assets</h2>
            <ul class="m-0 max-w-2xl list-none divide-y divide-main-border p-0">
                <li class="people-color">
                    <a href="/@teamSlug/people" class="group flex items-center gap-3 py-3 text-base-content hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                        <hero-icon variant="outline" name="users" class="size-5 text-[var(--asset-color)]"></hero-icon>
                        <span class="font-semibold group-hover:underline group-hover:underline-offset-4">People</span>
                        <hero-icon name="arrow-right" class="ml-auto size-4 text-base-content/40 group-hover:text-base-content"></hero-icon>
                    </a>
                </li>
                @if (canViewEquipment)
                {
                    <li class="equipment-color">
                        <a href="/@teamSlug/equipment" class="group flex items-center gap-3 py-3 text-base-content hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                            <hero-icon variant="outline" name="computer-desktop" class="size-5 text-[var(--asset-color)]"></hero-icon>
                            <span class="font-semibold group-hover:underline group-hover:underline-offset-4">Equipment</span>
                            <hero-icon name="arrow-right" class="ml-auto size-4 text-base-content/40 group-hover:text-base-content"></hero-icon>
                        </a>
                    </li>
                }
                @if (canViewAccess)
                {
                    <li class="access-color">
                        <a href="/@teamSlug/access" class="group flex items-center gap-3 py-3 text-base-content hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                            <hero-icon variant="outline" name="identification" class="size-5 text-[var(--asset-color)]"></hero-icon>
                            <span class="font-semibold group-hover:underline group-hover:underline-offset-4">Access</span>
                            <hero-icon name="arrow-right" class="ml-auto size-4 text-base-content/40 group-hover:text-base-content"></hero-icon>
                        </a>
                    </li>
                }
                @if (canViewKeys)
                {
                    <li class="keys-color">
                        <a href="/@teamSlug/keys" class="group flex items-center gap-3 py-3 text-base-content hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                            <hero-icon variant="outline" name="key" class="size-5 text-[var(--asset-color)]"></hero-icon>
                            <span class="font-semibold group-hover:underline group-hover:underline-offset-4">Keys</span>
                            <hero-icon name="arrow-right" class="ml-auto size-4 text-base-content/40 group-hover:text-base-content"></hero-icon>
                        </a>
                    </li>
                }
                @if (canViewSpaces)
                {
                    <li class="spaces-color">
                        <a href="/@teamSlug/spaces" class="group flex items-center gap-3 py-3 text-base-content hover:text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                            <hero-icon variant="outline" name="building-office-2" class="size-5 text-[var(--asset-color)]"></hero-icon>
                            <span class="font-semibold group-hover:underline group-hover:underline-offset-4">Spaces</span>
                            <hero-icon name="arrow-right" class="ml-auto size-4 text-base-content/40 group-hover:text-base-content"></hero-icon>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
</div>
