@model System.Collections.Generic.List<Keas.Core.Domain.EquipmentAttributeKey>
@{ ViewData["Title"] = "Equipment attribute keys"; }
<div class="space-y-10 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">Equipment attribute keys</h1>
            <p class="m-0 text-base-content/70">Manage the attribute keys available for your team’s equipment.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="TeamAdmin" asp-action="Index"><hero-icon name="arrow-left" class="size-4"></hero-icon>Team settings</a><a class="btn btn-primary" asp-action="Create"><hero-icon name="plus" class="size-4"></hero-icon>Create key</a></div>
    </div>
    <section class="space-y-4" aria-labelledby="team-keys-heading">
        <div class="space-y-2"><h2 id="team-keys-heading" class="m-0 text-xl font-bold">Team keys</h2>
        <p class="m-0 text-sm text-base-content/70">Keys created for this team.</p></div>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table" id="team-keys-table">
                <thead><tr><th scope="col">Key</th><th scope="col">Description</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Where(key => key.TeamId != null))
                {
                    <tr><td class="font-semibold">@item.Key</td><td>@item.Description</td><td><div class="flex justify-end gap-2">
                        <a class="btn btn-sm btn-ghost" asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit @item.Key">Edit</a>
                        <a class="btn btn-sm btn-ghost text-error" asp-action="Delete" asp-route-id="@item.Id" aria-label="Delete @item.Key">Delete</a>
                    </div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="space-y-4" aria-labelledby="global-keys-heading">
        <div class="space-y-2"><h2 id="global-keys-heading" class="m-0 text-xl font-bold">Global keys</h2>
        <p class="m-0 text-sm text-base-content/70">Shared keys are available across teams and cannot be edited here.</p></div>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table" id="global-keys-table">
                <thead><tr><th scope="col">Key</th><th scope="col">Description</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Where(key => key.TeamId == null))
                {
                    <tr><td class="font-semibold">@item.Key</td><td>@item.Description</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
@section Scripts {
    @await Html.PartialAsync("_CommonReportScripts")
    <script>
        $('#global-keys-table').DataTable();
        $('#team-keys-table').DataTable({columnDefs: [{ targets: -1, orderable: false }]});
    </script>
}
