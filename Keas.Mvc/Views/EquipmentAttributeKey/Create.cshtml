@model Keas.Core.Domain.EquipmentAttributeKey
@{ ViewData["Title"] = "Create equipment attribute key"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">Create equipment attribute key</h1>
            <p class="m-0 text-base-content/70">Define an attribute key for equipment in your team.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="EquipmentAttributeKey" asp-action="Index"><hero-icon name="arrow-left" class="size-4"></hero-icon>Attribute keys</a></div>
    </div>
    <form asp-action="Create" class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
        @await Html.PartialAsync("_EquipmentAttributeKeyForm")
        <div class="flex flex-wrap gap-2 border-t border-main-border pt-5">
            <button type="submit" class="btn btn-primary">Create equipment attribute key</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
