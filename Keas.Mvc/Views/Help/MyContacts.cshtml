@using Keas.Core.Domain
@model Keas.Core.Domain.Team
@{
    ViewData["Title"] = "My contacts";
    var roles = new[]
    {
        (Code: Role.Codes.DepartmentalAdmin, Title: "Team Admin", Icon: "trophy", Description: ""),
        (Code: Role.Codes.PersonManager, Title: "Person Manager", Icon: "user-circle", Description: "These contacts can edit people's details. For assignment questions, contact the appropriate asset admin."),
        (Code: Role.Codes.EquipmentMaster, Title: "Equipment Admin", Icon: "computer-desktop", Description: ""),
        (Code: Role.Codes.AccessMaster, Title: "Access Admin", Icon: "identification", Description: ""),
        (Code: Role.Codes.KeyMaster, Title: "Key Admin", Icon: "key", Description: ""),
        (Code: Role.Codes.SpaceMaster, Title: "Space/Workstation Admin", Icon: "building-office-2", Description: ""),
        (Code: Role.Codes.DocumentMaster, Title: "Document (DocuSign) Admin", Icon: "document-text", Description: "")
    };
    var groups = roles.Select(role => new
    {
        role.Title, role.Icon, role.Description,
        Contacts = Model.TeamPermissions.Where(permission => permission.Role.Name.Equals(role.Code, StringComparison.OrdinalIgnoreCase))
            .OrderBy(permission => permission.User.Name).ToList()
    }).Where(group => group.Contacts.Any()).ToList();
}
<div class="space-y-8 pb-8">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">My contacts</h1>
            <p class="m-0 text-base-content/70">Contact your team's admins for questions about your assignments or related emails.</p>
        </div>
        <a asp-action="Index" class="btn btn-ghost"><hero-icon name="arrow-left" class="size-4"></hero-icon>Help</a>
    </header>
    <p class="m-0 text-base-content/70">For technical issues, <a asp-action="TechSupport" class="link link-hover text-primary">create a help ticket</a>.</p>
    @if (groups.Any())
    {
        <div class="grid items-start gap-8 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var group in groups)
            {
                <section class="min-w-0 space-y-3" aria-label="@group.Title">
                    <h2 class="m-0 flex items-center gap-2 text-lg font-semibold">
                        <hero-icon name="@group.Icon" class="size-5"></hero-icon>@group.Title
                    </h2>
                    @if (!string.IsNullOrWhiteSpace(group.Description))
                    {
                        <p class="m-0 text-sm leading-6 text-base-content/70">@group.Description</p>
                    }
                    <ul class="m-0 list-none divide-y divide-main-border p-0">
                        @foreach (var contact in group.Contacts)
                        {
                            <li class="space-y-1 py-3">
                                <p class="m-0 font-semibold [overflow-wrap:anywhere]">@contact.User.Name</p>
                                @if (!string.IsNullOrWhiteSpace(contact.User.Email))
                                {
                                    <a class="link link-hover text-sm text-primary [overflow-wrap:anywhere]" href="mailto:@contact.User.Email">@contact.User.Email</a>
                                }
                                else
                                {
                                    <p class="m-0 text-sm text-base-content/60">No email listed.</p>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
    else
    {
        <p class="m-0 text-base-content/70">No team contacts are listed.</p>
    }
</div>
