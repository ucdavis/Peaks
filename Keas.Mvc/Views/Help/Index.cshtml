@using Keas.Core.Domain
@model Keas.Core.Domain.Team

@{
    ViewBag.Title = "Help";
    var contactRoles = new[]
    {
        (Code: Role.Codes.DepartmentalAdmin, Title: "Team Admin", Icon: "trophy", Description: "Team settings, permissions, and general questions."),
        (Code: Role.Codes.PersonManager, Title: "Person Manager", Icon: "user-circle", Description: "For changes to a person’s details. Contact the relevant asset admin for assignment questions."),
        (Code: Role.Codes.EquipmentMaster, Title: "Equipment Admin", Icon: "computer-desktop", Description: "Equipment and equipment assignments."),
        (Code: Role.Codes.AccessMaster, Title: "Access Admin", Icon: "identification", Description: "Access records and access assignments."),
        (Code: Role.Codes.KeyMaster, Title: "Key Admin", Icon: "key", Description: "Keys and key assignments."),
        (Code: Role.Codes.SpaceMaster, Title: "Space/Workstation Admin", Icon: "building-office-2", Description: "Spaces, workstations, and their assignments."),
        (Code: Role.Codes.DocumentMaster, Title: "Document (DocuSign) Admin", Icon: "document-text", Description: "Documents and DocuSign questions.")
    };
    var contactGroups = contactRoles.Select(role => new
    {
        role.Title,
        role.Icon,
        role.Description,
        Contacts = Model.TeamPermissions
            .Where(permission => permission.Role.Name.Equals(role.Code, StringComparison.OrdinalIgnoreCase))
            .OrderBy(permission => permission.User.Name)
            .ToList()
    }).Where(group => group.Contacts.Any()).ToList();
    var supportLinks = new[]
    {
        (Href: Url.Action("MyContacts"), Label: "Your assigned items", Icon: "users", External: false),
        (Href: "https://feedback.ucdavis.edu/app/Peaks", Label: "Share feedback", Icon: "chat-bubble-left-right", External: true),
        (Href: Url.Action("TechSupport"), Label: "Create help ticket", Icon: "lifebuoy", External: false),
        (Href: "https://computing.caes.ucdavis.edu/documentation/peaks", Label: "Guides & FAQ", Icon: "book-open", External: true)
    };
}

<div class="space-y-8 pb-8">
    <div class="space-y-2">
        <h1 class="m-0 text-3xl font-semibold text-base-content">Help</h1>
        <p class="m-0 text-base text-base-content/70">Find your team's contacts, get technical support, or share feedback about PEAKS.</p>
    </div>

    <nav aria-label="Help resources" class="flex flex-wrap gap-x-6 gap-y-3 border-b border-main-border pb-6">
        @foreach (var link in supportLinks)
        {
            <a class="inline-flex items-center gap-2 text-sm font-semibold text-base-content/80 hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-primary"
               href="@link.Href"
               target="@(link.External ? "_blank" : null)"
               rel="@(link.External ? "noopener noreferrer" : null)">
                <hero-icon name="@link.Icon" class="size-5 shrink-0 text-base-content/50" aria-hidden="true"></hero-icon>
                @link.Label
            </a>
        }
    </nav>

    <section aria-labelledby="contacts-heading" class="space-y-6">
        <h2 id="contacts-heading" class="m-0 text-xl font-semibold text-base-content">Team contacts</h2>
        @if (contactGroups.Any())
        {
            <div class="divide-y divide-main-border rounded-box border border-main-border bg-base-100">
                @foreach (var group in contactGroups)
                {
                    <section class="grid min-w-0 gap-5 p-5 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-8 lg:p-6" aria-label="@group.Title">
                        <div class="min-w-0 space-y-2">
                            <h3 class="m-0 flex items-start gap-2 text-base font-semibold text-base-content">
                                <hero-icon name="@group.Icon" class="mt-0.5 size-5 shrink-0 text-base-content/50" aria-hidden="true"></hero-icon>
                                @group.Title
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(group.Description))
                            {
                                <p class="m-0 text-sm leading-6 text-base-content/70">@group.Description</p>
                            }
                        </div>
                        <ul class="m-0 grid min-w-0 list-none content-start gap-x-6 gap-y-5 p-0 sm:grid-cols-2 xl:grid-cols-3">
                            @foreach (var contact in group.Contacts)
                            {
                                <li class="min-w-0 [overflow-wrap:anywhere]">
                                    <p class="m-0 font-semibold text-base-content">@contact.User.Name</p>
                                    @if (!string.IsNullOrWhiteSpace(contact.User.Email))
                                    {
                                        <a class="inline-block py-1 text-sm text-primary underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href="mailto:@contact.User.Email">@contact.User.Email</a>
                                    }
                                    else
                                    {
                                        <p class="m-0 py-1 text-sm text-base-content/70">No email listed.</p>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        }
        else
        {
            <p class="m-0 text-base-content/70">No team contacts are listed.</p>
        }
    </section>

    <p class="m-0 text-xs text-base-content/50">PEAKS version @ViewBag.Version</p>
</div>
