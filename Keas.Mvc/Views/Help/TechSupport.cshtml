@model Keas.Core.Domain.Team
@{ ViewData["Title"] = "Technical support"; }
<div class="space-y-8 pb-8">
    <header class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Technical support</h1>
            <p class="m-0 text-base-content/70">Choose the right contact for your question.</p>
        </div>
        <a asp-action="Index" class="btn btn-ghost"><hero-icon name="arrow-left" class="size-4"></hero-icon>Help</a>
    </header>
    <div class="grid gap-6 md:grid-cols-2">
        <section class="space-y-4 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
            <hero-icon name="users" class="size-6"></hero-icon>
            <h2 class="m-0 text-xl font-semibold">Questions about your stuff</h2>
            <p class="m-0 leading-6 text-base-content/70">For questions about assignments or emails about your stuff, contact your team's admins.</p>
            <a asp-action="MyContacts" class="link link-hover inline-flex items-center gap-2 text-primary">Find my contacts <hero-icon name="arrow-right" class="size-4"></hero-icon></a>
        </section>
        <section class="space-y-4 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
            <hero-icon name="lifebuoy" class="size-6"></hero-icon>
            <h2 class="m-0 text-xl font-semibold">Technical issues and general inquiries</h2>
            <p class="m-0 leading-6 text-base-content/70">Report a problem with PEAKS or ask a question unrelated to your assignments.</p>
            <a href="@($"https://caeshelp.ucdavis.edu/?appname=Peaks&team={Model.Slug}")" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Create help ticket <hero-icon name="arrow-top-right-on-square" class="size-4"></hero-icon></a>
        </section>
    </div>
</div>
