@model Keas.Mvc.Models.AdminMembersAddModel
@{ ViewData["Title"] = "Assign role"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-bold text-base-content">Assign role</h1>
            <p class="m-0 text-base-content/70">Choose a role and the person who should receive it.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-action="RoledMembers" ><hero-icon name="arrow-left" class="size-4"></hero-icon>System admins</a></div>
    </div>
    <form asp-action="AddAdmin" class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
        <div class="space-y-2">
            <label asp-for="RoleId" class="block text-sm font-semibold"></label>
            <select asp-for="RoleId" class="select w-full" asp-items='@(new SelectList(Model.Roles, "Id", "Name"))'></select>
            <span asp-validation-for="RoleId" class="block text-sm text-error"></span>
        </div>
        <div class="space-y-2">
            <label asp-for="UserEmail" class="block text-sm font-semibold"></label>
            <input asp-for="UserEmail" class="input w-full" aria-describedby="user-help" />
            <p id="user-help" class="m-0 text-sm text-base-content/60">Enter a UC Davis email address or Kerberos ID.</p>
            <span asp-validation-for="UserEmail" class="block text-sm text-error"></span>
        </div>
        <div class="flex flex-wrap gap-2 border-t border-main-border pt-5">
            <button type="submit" class="btn btn-primary">Assign role</button>
            <a class="btn btn-ghost" asp-action="RoledMembers">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
