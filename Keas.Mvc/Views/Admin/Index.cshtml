@model TeamsAndGroupsModel
@{ ViewData["Title"] = "Administration"; }
<div class="space-y-10 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Administration</h1>
            <p class="m-0 text-base-content/70">Manage teams, reporting groups, and system administrators.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-outline" asp-action="RoledMembers"><hero-icon name="users" class="size-4"></hero-icon>System admins</a></div>
    </div>
    <section class="space-y-4" aria-labelledby="teams-heading">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3"><h2 id="teams-heading" class="m-0 text-xl font-semibold">Teams</h2><span class="badge badge-ghost">@Model.Teams.Count()</span></div>
            <a class="btn btn-primary" asp-controller="Team" asp-action="Create"><hero-icon name="plus" class="size-4"></hero-icon>Create team</a>
        </div>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table dataTable" id="teams-table">
                <thead><tr><th scope="col">ID</th><th scope="col">Name</th><th scope="col">Slug</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Teams)
                {
                    <tr>
                        <td class="text-base-content/60">@item.Id</td>
                        <td class="font-semibold">@item.Name</td>
                        <td><code class="rounded-sm bg-base-200 px-2 py-1 text-sm">@item.Slug</code></td>
                        <td><div class="flex flex-wrap justify-end gap-2">
                            <a class="btn btn-sm btn-ghost" asp-controller="Team" asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit @item.Name">Edit</a>
                            <a href='@string.Format("/{0}/TeamAdmin/RoledMembers", item.Slug)' class="btn btn-sm btn-outline" aria-label="Manage roles for @item.Name">Admin roles</a>
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
    <section class="space-y-4" aria-labelledby="groups-heading">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3"><h2 id="groups-heading" class="m-0 text-xl font-semibold">Groups</h2><span class="badge badge-ghost">@Model.Groups.Count()</span></div>
            <a class="btn btn-outline" asp-controller="Team" asp-action="CreateGroup"><hero-icon name="plus" class="size-4"></hero-icon>Create group</a>
        </div>
        <p class="m-0 text-sm text-base-content/70">Groups bring multiple teams together for reporting.</p>
        <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4">
            <table class="table dataTable" id="groups-table">
                <thead><tr><th scope="col">ID</th><th scope="col">Name</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Groups)
                {
                    <tr>
                        <td class="text-base-content/60">@item.Id</td><td class="font-semibold">@item.Name</td>
                        <td class="text-right"><a class="btn btn-sm btn-ghost" asp-controller="Team" asp-action="GroupDetails" asp-route-id="@item.Id" aria-label="View @item.Name">View group<hero-icon name="arrow-right" class="size-4"></hero-icon></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
@section Scripts {
    @await Html.PartialAsync("_CommonReportScripts")


    <script type="text/javascript">

        $('#teams-table').DataTable({
            "columnDefs": [
                { "orderable": false, "targets": -1}
            ]
        });

        $('#groups-table').DataTable({
            "columnDefs": [
                { "orderable": false, "targets": -1}
            ]
        });

    </script>

}

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
