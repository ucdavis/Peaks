@model Keas.Mvc.Controllers.DemoConsent
@{ Layout = null; }
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Connect PEAKS</title>
<style>body{font:18px system-ui;background:#f3f5f8;color:#172b4d;margin:0}main{max-width:650px;margin:8vh auto;background:white;padding:36px;border-top:8px solid #ffbf00;border-radius:8px}button{font:inherit;padding:12px 18px;margin-right:12px;cursor:pointer}button[value=allow]{background:#002855;color:white;border:0}p{line-height:1.6}small{color:#526072}</style></head>
<body><main><small>PEAKS · LOCAL SANDBOX DEMO</small><h1>Connect @Model.Client to PEAKS?</h1>
<p>Signed in as <strong>@Model.User</strong>. This client can read equipment, assignments, and expiration dates in the <strong>Sandbox Team</strong>, subject to your PEAKS permissions.</p>
<p>Access lasts up to eight hours. You can revoke it at any time. This connection cannot change equipment or send messages.</p>
<form method="post" action="/oauth/authorize">@Html.AntiForgeryToken()
@foreach (var parameter in Model.Parameters) { <input type="hidden" name="@parameter.Key" value="@parameter.Value" /> }
<button type="submit" name="decision" value="allow">Allow read access</button><button type="submit" name="decision" value="deny">Cancel</button></form>
<p><small>The client supplies its display name. The sandbox uses fictional users and inventory.</small></p>
<a href="/oauth/connections">Manage connections</a></main></body></html>
