<section class="card mb-4 border border-main-border bg-base-100 shadow-sm" aria-labelledby="button-color-examples">
    <div class="card-body gap-4 p-5 sm:p-6">
        <h2 id="button-color-examples" class="text-xl font-semibold">Button color examples</h2>
        <div class="flex flex-wrap gap-3">
            <button type="button" class="btn">Default</button>
            <button type="button" class="btn btn-primary">Primary</button>
            <button type="button" class="btn btn-secondary">Secondary</button>
            <button type="button" class="btn btn-accent">Accent</button>
            <button type="button" class="btn btn-neutral">Neutral</button>
            <button type="button" class="btn btn-success">Success</button>
            <button type="button" class="btn btn-warning">Warning</button>
            <button type="button" class="btn btn-error">Error</button>
            <button type="button" class="btn btn-info">Info</button>
        </div>
        <h3 class="mt-2 text-lg font-semibold">Asset color examples</h3>
        <div class="flex flex-wrap gap-3">
            <span class="people-color">
                <button type="button" class="btn btn-asset">
                    <hero-icon variant="solid" name="users" class="size-5"></hero-icon> People
                </button>
            </span>
            <span class="equipment-color">
                <button type="button" class="btn btn-asset">
                    <hero-icon variant="solid" name="computer-desktop" class="size-5"></hero-icon> Equipment
                </button>
            </span>
            <span class="access-color">
                <button type="button" class="btn btn-asset">
                    <hero-icon variant="solid" name="identification" class="size-5"></hero-icon> Access
                </button>
            </span>
            <span class="keys-color">
                <button type="button" class="btn btn-asset">
                    <hero-icon variant="solid" name="key" class="size-5"></hero-icon> Keys
                </button>
            </span>
            <span class="spaces-color">
                <button type="button" class="btn btn-asset">
                    <hero-icon variant="solid" name="building-office-2" class="size-5"></hero-icon> Spaces
                </button>
            </span>
            <span class="documents-color">
                <button type="button" class="btn btn-asset">
                    <hero-icon variant="solid" name="document-text" class="size-5"></hero-icon> Documents
                </button>
            </span>
        </div>
    </div>
</section>
