@model TeamsAndGroupsModel


@{
    ViewData["Title"] = "Select Team";
}

<div class="card mb-4 border border-main-border bg-base-100 shadow-sm">
    <div class="border-b border-main-border">
        <div class="px-5 py-4 sm:px-6">
            <h2 class="text-xl font-semibold">Select a Team</h2>
        </div>
    </div>
    <div class="card-body gap-4 p-5 sm:p-6">
        @foreach (var item in Model.Teams)
        {
            <p><a href='@string.Format("/{0}/{1}", item.Slug, ViewBag.urlRedirect)' class="btn btn-success min-w-48">@item.Name</a></p>
        }
    </div>
</div>
