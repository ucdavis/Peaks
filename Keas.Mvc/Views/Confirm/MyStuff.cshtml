@using Keas.Core.Extensions
@model Keas.Mvc.Models.MyStuffListModel

@{
    ViewData["Title"] = "MyStuff";
}
@if(Model.PendingItems){
    var currentSlug = TempData["TeamName"] as string;
    if (Model.TeamsWithPendingAssignments.Any(a => a.Slug != null && a.Slug == currentSlug))
    {
        <div class="alert alert-info mb-4">
            <hero-icon variant="outline" name="squares-2x2" class="size-6"></hero-icon>
            <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <p class="m-0 font-bold">You have pending items!</p>
                <a asp-controller="Confirm" asp-action="Confirm" class="link link-hover inline-flex items-center gap-2">Go to Accept page <hero-icon variant="outline" name="arrow-right" class="size-4"></hero-icon></a>
            </div>
        </div>
    }
    if (Model.TeamsWithPendingAssignments.Any(a => a.Slug != currentSlug))
    {
        <h3 class="text-lg font-semibold">You have items pending in other teams:</h3>
        foreach (var teamWithPending in Model.TeamsWithPendingAssignments.Where(a => a.Slug != currentSlug))
        {
            <div class="alert alert-info mb-4">
                <hero-icon variant="outline" name="squares-2x2" class="size-6"></hero-icon>
                <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                    <p class="m-0 font-bold">You have pending items in team @teamWithPending.Name!</p>
                    <a href='@string.Format("/{0}/Confirm/Confirm", teamWithPending.Slug)' class="link link-hover inline-flex items-center gap-2">Go to Accept page <hero-icon variant="outline" name="arrow-right" class="size-4"></hero-icon></a>
                </div>
            </div>
        }
    }
}
<header class="mb-6">
    <h1 class="m-0 text-3xl font-semibold text-base-content">MyStuff</h1>
</header>
<div class="card mb-4 border border-main-border bg-base-100 shadow-sm keys-color">
  <div class="card-header-keys">
    <div class="px-5 py-4 sm:px-6">
  <h2 class="m-0 flex items-center gap-2 text-xl font-semibold"><hero-icon variant="solid" name="key" class="size-5"></hero-icon> Keys</h2>
    </div>
  </div>
  <div class="card-body gap-4 p-5 sm:p-6">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Serial</th>
            <th>Name</th>
            <th>Expiration</th>
            <th>Accepted?</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var serial in Model.KeySerials) {
          <tr>
            <td>@serial.Key.Code</td>
            <td>@serial.Number</td>
            <td>@serial.Key.Name</td>
            <td>@serial.KeySerialAssignment.ExpiresAt.ToShortDateString()</td>
            <td>@serial.KeySerialAssignment.ConfirmedAt.AcceptedWithDate()</td>
          </tr>
          }

          @if (!Model.KeySerials.Any()) {
            <tr>
              <td colspan="5">You have no Keys assigned.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
<div class="card mb-4 border border-main-border bg-base-100 shadow-sm equipment-color">
  <div class="card-header-equipment">
    <div class="px-5 py-4 sm:px-6">
      <h2 class="m-0 flex items-center gap-2 text-xl font-semibold"><hero-icon variant="solid" name="computer-desktop" class="size-5"></hero-icon> Equipment</h2></div>
  </div>
  <div class="card-body gap-4 p-5 sm:p-6">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Serial Number</th>
            <th>Name</th>
            <th>Make</th>
            <th>Model</th>
            <th>Room</th>
            <th>Expiration</th>
            <th>Accepted?</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var equipment in Model.Equipment) {
          <tr>
            <td>@equipment.SerialNumber</td>
            <td>@equipment.Name</td>
            <td>@equipment.Make</td>
            <td>@equipment.Model</td>
            <td>@equipment.Space?.ShortName</td>
            <td>@equipment.Assignment.ExpiresAt.ToShortDateString()</td>
            <td>@equipment.Assignment.ConfirmedAt.AcceptedWithDate()</td>
          </tr>
          }
          @if(!Model.Equipment.Any()){
            <tr>
              <td colspan="7">You have no equipment assigned.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mb-4 border border-main-border bg-base-100 shadow-sm access-color">
  <div class="card-header-access">
    <div class="px-5 py-4 sm:px-6">
      <h2 class="m-0 flex items-center gap-2 text-xl font-semibold"><hero-icon variant="solid" name="identification" class="size-5"></hero-icon> Access</h2></div>
  </div>
  <div class="card-body gap-4 p-5 sm:p-6">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Expiration</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var access in Model.Access) {
          <tr>
            <td>@access.Name</td>
            <td>@access.Assignments.First().ExpiresAt.ToShortDateString()</td>
          </tr>
          }
           @if(!Model.Access.Any()){
            <tr>
              <td colspan="2">You have no access assigned.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>


<div class="card mb-4 border border-main-border bg-base-100 shadow-sm spaces-color">
  <div class="card-header-spaces">
    <div class="px-5 py-4 sm:px-6">
      <h2 class="m-0 flex items-center gap-2 text-xl font-semibold"><hero-icon variant="solid" name="building-office-2" class="size-5"></hero-icon> Workstations</h2></div>
  </div>
  <div class="card-body gap-4 p-5 sm:p-6">

    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Room</th>
            <th>Expiration</th>
            <th>Accepted?</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var workstation in Model.Workstations) {
          <tr>
            <td>@workstation.Title</td>
            <td>@workstation.Space.ShortName</td>
            <td>@workstation.Assignment.ExpiresAt.ToShortDateString()</td>
            <td>@workstation.Assignment.ConfirmedAt.AcceptedWithDate()</td>
          </tr>
          }
          @if(!Model.Workstations.Any()){
            <tr>
              <td colspan="4">You have no workstations assigned.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>

  </div>
</div>

<div class="card mb-4 border border-main-border bg-base-100 shadow-sm documents-color">
  <div class="card-header-documents">
    <div class="px-5 py-4 sm:px-6">
      <h2 class="m-0 flex items-center gap-2 text-xl font-semibold"><hero-icon variant="solid" name="briefcase" class="size-5"></hero-icon> Documents</h2></div>
  </div>
  <div class="card-body gap-4 p-5 sm:p-6">

    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Date</th>
            <th>Link</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var document in Model.Documents) {
          <tr>
            <td>@document.Name</td>
            <td>@document.Status</td>
            <td>@(document.CompletedAt.HasValue ? document.CompletedAt : document.CreatedAt)</td>
            <td><a href="@Model.DocumentUrlResolver(document.EnvelopeId)" target="_blank" rel="noopener noreferrer" class="link link-hover">View</a></td>
          </tr>
          }
          @if(!Model.Documents.Any()){
            <tr>
              <td colspan="4">You have no documents assigned.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>

  </div>
</div>

<div class="card mb-4 border border-main-border bg-base-100 shadow-sm history-color">
  <div class="px-5 py-4 sm:px-6">
    <h2 class="m-0 flex items-center gap-2 text-xl font-semibold"><hero-icon variant="solid" name="clock" class="size-5"></hero-icon> History</h2></div>
  <div class="card-body gap-4 p-5 sm:p-6">


    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr><th scope="col">Date</th><th scope="col">Activity</th></tr>
        </thead>
        <tbody>
          @foreach (var history in Model.Histories) {
          <tr>
            <td>@history.ActedDate.ToShortDateString()</td>
            <td>@history.Description</td>
          </tr>
          }
          @if(!Model.Histories.Any()){
            <tr>
              <td colspan="2">No history to display</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
