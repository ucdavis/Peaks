@model Keas.Core.Domain.Tag
@{ ViewData["Title"] = "Delete tag"; }
<div class="space-y-6 pb-8">
<div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            @await Html.PartialAsync("_ActiveTeamEyebrow")
            <h1 class="m-0 text-3xl font-semibold text-base-content">Delete tag</h1>
            <p class="m-0 text-base-content/70">Organize your team’s people and assets with reusable tags.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2"><a class="btn btn-ghost" asp-controller="TagsManager" asp-action="Index"><hero-icon name="arrow-left" class="size-4"></hero-icon>Team tags</a></div>
    </div>
    <form asp-action="Delete" class="max-w-xl space-y-5 rounded-sm border border-main-border bg-base-100 p-5 sm:p-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>
        <input type="hidden" asp-for="Id" />
        <p class="m-0">Are you sure you want to delete this tag?</p>
        <dl class="m-0 space-y-3">
            <div><dt class="text-sm text-base-content/60">@Html.DisplayNameFor(model => model.Name)</dt><dd class="m-0 mt-1 break-words font-semibold">@Model.Name</dd></div>
        </dl>
        <div class="flex flex-wrap gap-2 border-t border-main-border pt-5">
            <button type="submit" class="btn btn-error">Delete tag</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
