@model Keas.Mvc.Models.GroupModels.GroupIndexViewModel

@{
    ViewBag.Title = "title";
}

<div class="card">
    <div class="card-header-primary">
        <div class="row justify-content-between">
            <div class="card-head">
                <h2><hero-icon name="clipboard-document-list" class="size-4"></hero-icon> Reports for group: @Model.Group.Name</h2>
            </div>
        </div>
    </div>
    <div class="card-content">
        <div class="row">

            <div class="report-list equipment-color col-md-3">
                <h3><hero-icon name="computer-desktop" class="size-4"></hero-icon> Equipment Reports</h3>
                <ul>
                    <li>
                        <a asp-action="EquipmentReport" asp-route-id="@Model.Group.Id">View All Equipment <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>

                </ul>
            </div>


            <div class="report-list spaces-color col-md-3">
                <h3><hero-icon name="building-office-2" class="size-4"></hero-icon> Workstations Reports</h3>
                <ul>
                    <li>
                        <a asp-action="WorkstationReport" asp-route-id="@Model.Group.Id">View All Workstations <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                </ul>
            </div>

            <div class="report-list keys-color col-md-3">
                <h3><hero-icon name="building-office-2" class="size-4"></hero-icon> Key Reports</h3>
                <ul>
                    <li>
                        <a asp-action="KeySerialsWithSpacesReport" asp-route-id="@Model.Group.Id">View Key Serials with Spaces <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                    <li>
                        <a asp-action="KeySerialsReport" asp-route-id="@Model.Group.Id">View Key Serials <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                </ul>
            </div>

            <div class="report-list documents-color col-md-3">
                <h3><hero-icon name="document-text" class="size-4"></hero-icon> Documents Reports</h3>
                <ul>
                    <li>
                        <a asp-action="IncompleteDocumentsReport" asp-route-id="@Model.Group.Id">View All Incomplete Docs <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                    <li>
                        <a asp-action="CompletedDocumentsReport" asp-route-id="@Model.Group.Id">Completed Documents <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>
                </ul>
            </div>

            <div class="report-list people-color col-md-3">
                <h3><hero-icon name="users" class="size-4"></hero-icon> People Reports</h3>
                <ul>
                    <li>
                        <a asp-action="PeopleLeavingWithAssets" asp-route-id="@Model.Group.Id">People with Assets who are Leaving <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></a>
                    </li>

                </ul>
            </div>
            <div class="report-list general-color col-md-3">
                <h3><hero-icon name="list-bullet" class="size-4"></hero-icon> General Reports</h3>
                <ul>
                    <li>
                        <a asp-action="ExpiringItems" asp-route-id="@Model.Group.Id">Expiring <span style="white-space: nowrap;">Items <hero-icon name="chevron-right" class="size-4" aria-hidden="true"></hero-icon></span></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header-primary">
        <div class="row justify-content-between">
            <div class="card-head">
                <h2><hero-icon name="clipboard-document-list" class="size-4"></hero-icon> Teams in group: @Model.Group.Name</h2>
            </div>
        </div>
    </div>
    <div class="card-content">
        <table id="teams-in-group" class="table dataTable">
            <thead>
            <tr>
                <th>Team Name</th>
                <th>Team Slug</th>
                <th>All Dept Admins</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.TeamContact.Where(a => a.InGroup))
            {
                <tr>
                    <td>@item.TeamName</td>
                    <td>@item.TeamSlug</td>
                    <td><a href="mailto: @item.AllDeptAdmins">@item.AllDeptAdmins</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="card">
    <div class="card-header-primary">
        <div class="row justify-content-between">
            <div class="card-head">
                <h2><hero-icon name="clipboard-document-list" class="size-4"></hero-icon> Teams NOT in group: @Model.Group.Name</h2>
            </div>
        </div>
    </div>
    <div class="card-content">
        <table id="teams-in-group" class="table dataTable">
            <thead>
            <tr>
                <th>Team Name</th>
                <th>Team Slug</th>
                <th>All Dept Admins</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.TeamContact.Where(a => !a.InGroup))
            {
                <tr>
                    <td>@item.TeamName</td>
                    <td>@item.TeamSlug</td>
                    <td><a href="mailto: @item.AllDeptAdmins">@item.AllDeptAdmins</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ReportScriptsPartial");}
}



