@model Keas.Mvc.Models.ReportModels.DocumentReportGroupViewModel

@{
    ViewData["Title"] = "People With Incomplete Documents";
}

<div class="space-y-6 pb-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 space-y-2">
            <p class="m-0 text-sm font-semibold uppercase tracking-wide text-base-content/60">@Model.Group.Name</p>
            <h1 class="m-0 text-3xl font-semibold text-base-content">People With Incomplete Documents</h1>
        </div>
        <a asp-action="Index" asp-route-id="@Model.Group.Id" class="btn btn-ghost">Back to Group Home</a>
    </div>
    <div class="overflow-x-auto rounded-sm border border-main-border bg-base-100 p-4 sm:p-6">
        <table class="table dataTable">
            <thead>
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Email
                </th>
                <th>
                    Incomplete Document Count
                </th>
                <th>Team</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.IncompleteDocuments) {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IncompleteDocumentCount)
                    </td>
                    <td>@item.TeamName</td>
                    <td>
                        <a href='@string.Format("/{0}/{1}/details/{2}", item.TeamSlug, "People", item.PersonId)' target="_blank">Details</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    @await Html.PartialAsync("_ReportStylePartial")
}
@section Scripts {
    @{await Html.RenderPartialAsync("_ImportJS");}

    <script type="text/javascript">
        $('.dataTable').DataTable({
            "layout": { topStart: ['pageLength', 'buttons'] },
            "buttons": [
                { extend: 'copyHtml5' },
                { extend: 'excelHtml5' },
                { extend: 'csvHtml5' },
                { extend: 'print' },
            ]
        });
    </script>
}
