{
  "name": "kaes-mvc",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "testwatch": "vitest",
    "citest": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "test:launcher": "node --test scripts/dev-server.test.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/react-fontawesome": "0.1.19",
    "@ucdavis/gunrockin": "1.1.3",
    "bootstrap": "4.5.0",
    "date-fns": "2.14.0",
    "isomorphic-fetch": "2.2.1",
    "jquery": "3.5.1",
    "log4javascript": "1.4.15",
    "react": "17.0.2",
    "react-bootstrap-typeahead": "6.2.3",
    "react-date-picker": "8.3.6",
    "react-dom": "17.0.2",
    "react-router": "5.2.0",
    "react-router-dom": "5.2.0",
    "react-table": "7.8.0",
    "react-toastify": "6.0.8",
    "reactstrap": "9.1.6",
    "stacktrace-js": "2.0.2",
    "yup": "0.29.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/date-fns": "2.6.0",
    "@types/history": "4.7.6",
    "@types/isomorphic-fetch": "0.0.35",
    "@types/node": "^22.18.0",
    "@types/react": "^17.0.37",
    "@types/react-bootstrap-typeahead": "^5.1.9",
    "@types/react-dom": "^17.0.11",
    "@types/react-router": "5.1.8",
    "@types/react-router-dom": "5.1.5",
    "@types/react-table": "^7.7.14",
    "@types/react-toastify": "4.1.0",
    "@types/yup": "0.29.3",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.21",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "2.0.5",
    "sass": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  }
